{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/**,supabase/prod-ca-2021.crt}"
    }
  },
  "routes": [
    {
      "src": "/assets/english-tech-brand-(hero|mark)\\.webp",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(auth|admin|app|onboarding)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index"
    },
    {
      "src": "/(robots.txt|sitemap.xml)",
      "dest": "/api/index"
    },
    {
      "src": "/",
      "dest": "/landing.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
