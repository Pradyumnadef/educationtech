# Runtime mode defaults to development; production is set by the host.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Production: a PostgreSQL connection URL is required. Leave blank for local SQLite.
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local verification codes are shown only on this computer; configure a real provider before deployment.
# Production OTP: Twilio Verify, with SMS and/or email integration configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Production storage: private S3 bucket with CORS PUT allowed from APP_ORIGIN.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Match this to the storage provider's plan. Supabase Free allows 50 MB.
VIDEO_UPLOAD_MAX_MB=50
# A scanner must inspect quarantined objects and call POST /api/storage/scan-result.
SCANNER_WEBHOOK_SECRET=
# Set behind exactly one trusted reverse proxy only.
TRUST_PROXY=false
# Optional CloudFront edge cache. Requests still pass through the permission gateway.
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_BASE64=
# Scanner worker (compose supplies the ClamAV host).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FFPROBE_PATH=ffprobe
LOCAL_OTP=true
# Required for first-teacher setup on a public deployment; use 32+ random characters.
TEACHER_SETUP_KEY=

# Optional real Supabase authentication: see supabase/AUTH-SETUP.md
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
EMAIL_OTP_PROVIDER=supabase
EMAIL_OTP_READY=false
GOOGLE_AUTH_ENABLED=false
