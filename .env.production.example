NODE_ENV=production
PORT=3000
APP_ORIGIN=https://learn.example.com
DATABASE_URL=postgres://lumio:replace-password@db:5432/lumio
DATABASE_SSL=false
# For the existing English-Tech Supabase project, set SSL and managed schema to true.
DATABASE_MANAGED_SCHEMA=false
# Supabase only: supabase/prod-ca-2021.crt
DATABASE_CA_FILE=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_MODE=false
SEED_DEMO=false
TRUST_PROXY=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SCANNER_WEBHOOK_SECRET=replace-with-a-separate-random-secret
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_BASE64=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

LOCAL_OTP=false
# Set a private random key (32+ characters), use it once at /auth/setup, then remove it.
TEACHER_SETUP_KEY=

# Supabase authentication (configure providers before setting ready flags)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
EMAIL_OTP_PROVIDER=supabase
EMAIL_OTP_READY=false
GOOGLE_AUTH_ENABLED=false
