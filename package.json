{
  "name": "english-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.ts",
    "build": "tsc --noEmit && vite build --configLoader native && tsx src/prerender.tsx",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "setup": "node server/setup.ts",
    "scanner": "node server/scanner.ts",
    "create-admin": "node server/create-admin.ts",
    "format": "prettier --write src server tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/cloudfront-signer": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@supabase/supabase-js": "2.116.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "pdfjs-dist": "^5.4.149",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
